# ─────────────────────────────────────────────────────────────────────────────
# Environment variables for the Shivasankalpa website.
#
# Copy this file to `.env.local` for local development (already gitignored) and
# set the same keys in Vercel → Project → Settings → Environment Variables for
# production. NEVER commit real secrets to the repository.
# ─────────────────────────────────────────────────────────────────────────────

# Contact form → Hostinger SMTP relay ─────────────────────────────────────────
# Used by `app/api/contact/route.ts` to deliver messages from the website's
# contact form to the trust's mailbox.

# Hostinger SMTP host. Use TLS-on-connect on port 465 (the default below).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
# Leave SMTP_SECURE unset to derive from port (465 → true, 587 → false).
# SMTP_SECURE=true

# Full mailbox address + its password from the Hostinger control panel.
SMTP_USER=info@shivasankalpa.org
SMTP_PASS=

# Optional overrides. Defaults to SMTP_USER when omitted.
# CONTACT_TO=info@shivasankalpa.org
# CONTACT_FROM=info@shivasankalpa.org
# CONTACT_FROM_NAME=Shivasankalpa Website
# CONTACT_SUBJECT_PREFIX=[Website]

# Sanity CMS (events, gallery photos) ────────────────────────────────────────
# Project ID is public (used in the browser). Dataset is `production`.
# Copy these from `.env.local` after `npx sanity init`. Also set them in
# Vercel → Project → Settings → Environment Variables (Production + Preview).
NEXT_PUBLIC_SANITY_PROJECT_ID=qpr0e4qa
NEXT_PUBLIC_SANITY_DATASET=production
# NEXT_PUBLIC_SANITY_API_VERSION=2026-09-20
# SANITY_REVALIDATE_SECRET=
